CONNECTION_STRING=Host=postgres;Port=5432;Database=libraryservice;Username=library;Password=library

API_PORT=8080
FE_PORT=5173
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
API_TARGET=http://api:8080

API_CONTEXT=../LibrariesApiTest
FE_CONTEXT=../LibrariesFE
