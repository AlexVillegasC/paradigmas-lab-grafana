# Copy to .env.local (or keep the committed lab defaults).
APP_ENV=local
ENV_FILE=.env.local
ASPNETCORE_ENVIRONMENT=Local
ASPNETCORE_HTTP_PORTS=8080

POSTGRES_DB=libraryservice
POSTGRES_USER=library
POSTGRES_PASSWORD=library
