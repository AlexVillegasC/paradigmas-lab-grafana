# Copy to .env.development and replace the Supabase connection string.
APP_ENV=development
ENV_FILE=.env.development
ASPNETCORE_ENVIRONMENT=Development

CONNECTION_STRING=Host=db.YOUR_PROJECT.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

API_PORT=8080
FE_PORT=5173
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
API_TARGET=http://api:8080

API_CONTEXT=../LibrariesApiTest
FE_CONTEXT=../LibrariesFE
